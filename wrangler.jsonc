{
  "name": "proto-build",
  "pages_build_output_dir": "./app",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "GITHUB_REPO": "dannyagency98-coder/protobuild",
    "GITHUB_WORKFLOW_FILE": "capture.yml",
    "GITHUB_REF": "main"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "prototype-builder"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GEMINI_KV",
      "id": "a2534035e36341d0b1856bd44f1c6836"
    }
  ]
}

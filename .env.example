# Copy to .env and fill (never commit .env)

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# App
APP_ORIGIN=https://app.yourdomain.com
PREVIEW_DOMAIN=yourdomain.com

# Optional. The chat agent uses this for replies. Scans still run without it.
XAI_API_KEY=

# Gemini Flash. One short call per finished scan, and one call per edit.
# A 429 stores gemini-down-until. Per-minute waits about 60 seconds. Per-day waits until midnight Pacific.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare Worker only. An https tunnel to Ollama. Never 127.0.0.1.
# The Worker calls qwen2.5-coder:1.5b here while gemini-down-until is set.
OLLAMA_TUNNEL_URL=

# Pages bindings, set in Cloudflare, not in this file: R2 bucket "R2", KV namespace "GEMINI_KV".
